{
  "layer": "top",
  "position": "top",
  "height": 38,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "clock",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 80,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %A}"
  },

  "battery": {
    "format": "{capacity}% "
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀"
  },

  "pulseaudio": {
      "format": " {volume}%",
      "format-muted": " Muted"
  },

  "tray": {
    "spacing": 15
  },

  "custom/power": {
    "format" : "⏻",
    "on-click": "wlogout"
  }
}
